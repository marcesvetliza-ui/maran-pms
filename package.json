{
  "name": "rest-express",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "rm -rf node_modules/.vite && tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "test": "vitest run && vitest run --config vitest.server.config.ts && if [ -n \"$DATABASE_URL\" ]; then npm run test:postgres; else echo '[test] DATABASE_URL no configurada: se omiten las pruebas de integración PostgreSQL. Ejecute npm run test:postgres con una base de desarrollo migrada.'; fi",
    "test:postgres": "if [ -z \"$DATABASE_URL\" ]; then echo 'DATABASE_URL es obligatoria para las pruebas PostgreSQL. Use una base de desarrollo/pruebas migrada, nunca producción.' >&2; exit 1; fi; vitest run --config vitest.server.pg.config.ts",
    "db:migrate:ci": "tsx script/ci-migrate.ts",
    "test:watch": "vitest",
    "lint:dates": "bash script/check-date-patterns.sh",
    "test:dates": "bash script/test-check-date-patterns.sh",
    "lint:workflows": "node script/check-workflows.mjs",
    "test:workflows": "node script/test-check-workflows.mjs"
  },
