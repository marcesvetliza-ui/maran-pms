FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY script/build-xenia-control.mjs script/build-xenia-control.mjs
COPY server/xenia-control server/xenia-control
COPY server/xenia-pms/config.ts server/xenia-pms/config.ts
COPY shared/xeniaPms.ts shared/xeniaPms.ts
RUN npm run xenia:build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/dist/xenia-control ./dist/xenia-control
USER node
EXPOSE 4186
CMD ["node", "dist/xenia-control/index.js"]
